# Immich instance the MCP server talks to (as reachable from inside the container)
IMMICH_URL=http://immich-server:2283
# API key: Immich -> Account Settings -> API Keys. Needed permissions:
# asset.read, asset.view, person.read, tag.read, album.read
IMMICH_API_KEY=

# Bearer token MCP clients must send: Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# Address of Immich used in photo links shown to the user (default: IMMICH_URL)
# IMMICH_PUBLIC_URL=https://photos.example.com
# MCP_PORT=8000
# IMMICH_TIMEOUT=30
